# Mingle Production Environment Variables
# Copy this to .env and update with real values

# Database Credentials (change these!)
POSTGRES_USER=mingle
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=mingle

MONGODB_USER=mingle
MONGODB_PASSWORD=your-secure-mongodb-password
MONGODB_DB=mingle

CLICKHOUSE_USER=mingle
CLICKHOUSE_PASSWORD=your-secure-clickhouse-password
CLICKHOUSE_DB=mingle_analytics

# Application Security (change this!)
SECRET_KEY=your-very-long-random-secret-key-at-least-32-chars
