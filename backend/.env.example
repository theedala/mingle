# Environment
ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_USER=mingle
POSTGRES_PASSWORD=mingle_secret
POSTGRES_DB=mingle

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=mingle
MONGODB_PASSWORD=mingle_secret
MONGODB_DB=mingle

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9001
CLICKHOUSE_USER=mingle
CLICKHOUSE_PASSWORD=mingle_secret
CLICKHOUSE_DB=mingle_analytics

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]
